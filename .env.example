DISCORD_TOKEN=put_discord_bot_token_here
DISCORD_CLIENT_ID=put_discord_application_client_id_here

# Open-LLM-VTuber backend. Default backend port is usually 12393.
OPEN_LLM_VTUBER_WS=ws://127.0.0.1:12393/client-ws

# Bot behavior
BOT_TRIGGER_MODE=mention
BOT_ALLOWED_CHANNEL_IDS=
BOT_IGNORED_USER_IDS=
BOT_REPLY_TIMEOUT_MS=90000
BOT_MAX_REPLY_CHARS=1800
BOT_ENABLE_TYPED_STATUS=true
